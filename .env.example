# Copy to .env (git-ignored) and fill in. Never commit real secrets.

# Claude API key. Leave empty to run in degraded (fallback-only) mode.
ANTHROPIC_API_KEY=

# claude | extractive (deterministic offline baseline, no API calls)
LLM_BACKEND=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

AUDIT_DB_PATH=audit.db
LOG_LEVEL=INFO
